# Copy to .env and fill in. .env is git-ignored; each teammate uses their own keys.
# Names are whatever your system reads through labkit.env.require_env("NAME").
MODEL_API_KEY=your-api-key

# Tracing stays off: batch runs would send thousands of traces. labkit also forces this in-process.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
